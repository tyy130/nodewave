{
  "name": "@nodewave/core",
  "version": "0.1.0",
  "description": "nodewave core engine — detectors, adapters, harvester, upgraders, templates, config",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build"
  },
  "files": ["dist", "src/templates"],
  "dependencies": {
    "chalk": "^5.3.0",
    "execa": "^9.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.2.4",
    "typescript": "^5.4.5"
  }
}
