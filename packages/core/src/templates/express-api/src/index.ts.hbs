import express from 'express';

const app = express();
const port = process.env.PORT ?? 3000;

app.use(express.json());

app.get('/', (_req, res) => {
  res.json({ message: '{{projectName}} is running 🌊' });
});

app.listen(port, () => {
  console.log(`[{{projectName}}] Server running on port ${port}`);
});
