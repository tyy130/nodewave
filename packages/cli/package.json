{
  "name": "nodewave-cli",
  "version": "0.1.0",
  "description": "Seamless build, deploy, and upgrade for Next.js and Node.js projects",
  "keywords": ["nextjs", "next.js", "vercel", "netlify", "railway", "deploy", "cli", "node", "upgrade", "doctor"],
  "homepage": "https://github.com/nodewave/nodewave",
  "repository": { "type": "git", "url": "https://github.com/nodewave/nodewave.git" },
  "license": "MIT",
  "author": "nodewave",
  "main": "./dist/cli.mjs",
  "bin": {
    "nodewave": "./dist/cli.mjs"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build"
